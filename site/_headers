# Security headers for every response (Cloudflare Pages format; dev/serve.py sends the same ones).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://playerdb.co http://127.0.0.1:47815 http://127.0.0.1:47816 http://127.0.0.1:47817; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  ! Access-Control-Allow-Origin

# The moving page passes saved things from the old address to the new one in a tab it opens, which needs the two tabs to
# stay linked (window.opener), so it alone drops the opener isolation.
/move.html
  ! Cross-Origin-Opener-Policy
  Cross-Origin-Opener-Policy: unsafe-none
/move
  ! Cross-Origin-Opener-Policy
  Cross-Origin-Opener-Policy: unsafe-none

# Code and styles: always ask the server whether they changed (cheap with ETags), so a deploy never leaves a browser
# running a mix of old and new files. Fonts and the pinned three.js keep the host's default caching.
/app/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
