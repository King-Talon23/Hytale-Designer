// Hytale Designer Sync: the in-game wardrobe. The picture is the game's Lumberjack wardrobe with its doors open and a second rack,
// rendered by dev/tools/render-wardrobe.py, which also prints the numbers this layout uses (interior at 177,87 size 521 x 402, seen between the front posts from x 190 to 684; the
// top rack's row from interior y 0, the bottom rack's from y 201; five hangers of 98 to a rack from x 192; page arrows on the doors).
// Top rack: the player's own skin (the in-game preset slots join it once Hytale allows sign-in). Bottom rack: the Locker's skins,
// five to a page; the plugin appends five WardrobeCard.ui into #Grid and fills them for the page shown.
$C = "../../Common.ui";

@HeadStyle = LabelStyle(
  FontSize: 12,
  VerticalAlignment: Center,
  RenderUppercase: true,
  TextColor: #c7ae7a,
  FontName: "Secondary",
  RenderBold: true,
  LetterSpacing: 0.5
);

@NameStyle = LabelStyle(
  FontSize: 12,
  Wrap: true,
  TextColor: #ecdcb8,
  FontName: "Secondary",
  RenderBold: true,
  HorizontalAlignment: Center,
  VerticalAlignment: Center
);

$C.@PageOverlay {
  LayoutMode: Middle;

  Group {
    Anchor: (Width: 888, Height: 760);

    Label {
      Anchor: (Left: 0, Top: 0, Width: 888, Height: 40);
      Text: "Wardrobe";
      Style: (...$C.@TitleStyle, FontSize: 22, HorizontalAlignment: Center, LetterSpacing: 1);
    }

    Group {
      Anchor: (Left: 0, Top: 40, Width: 888, Height: 694);
      Background: (TexturePath: "Wardrobe.png");

      Label {
        Anchor: (Left: 198, Top: 89, Width: 300, Height: 18);
        Text: "Your skins";
        Style: @HeadStyle;
      }

      // the player's own skin, worn whenever no Locker skin is
      Group {
        Anchor: (Left: 192, Top: 87, Width: 98, Height: 200);

        Group #OwnWorn {
          Anchor: (Left: 0, Top: 56, Width: 98, Height: 150);
          Background: (TexturePath: "WornGlow.png");
          Visible: false;
        }

        Button #OwnCard {
          Anchor: (Left: 0, Top: 0, Width: 98, Height: 200);
          Style: (
            Default: (Background: #000000(0)),
            Hovered: (Background: (TexturePath: "HoverGlow.png")),
            Pressed: (Background: (TexturePath: "HoverGlow.png")),
            Sounds: $C.@ButtonSounds
          );

          Group #OwnHang {
            Anchor: (Left: 0, Top: 0, Width: 98, Height: 200);

            Group {
              Anchor: (Left: 40, Top: 23, Width: 19, Height: 54);
              Background: (TexturePath: "Hook.png");
            }

            AssetImage #OwnPic {
              Anchor: (Left: 19, Top: 68, Width: 60, Height: 98);
              FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
            }

            Label #OwnName {
              Anchor: (Left: 2, Top: 166, Width: 94, Height: 32);
              Style: @NameStyle;
            }
          }
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Left: 198, Top: 290, Width: 482, Height: 18);

        Label {
          Text: "Designer skins";
          Style: @HeadStyle;
        }

        Label #Count {
          Padding: (Left: 10);
          Text: "0";
          Style: (...@HeadStyle, TextColor: #8f7c58);
        }

        Group { FlexWeight: 1; }

        Label #Page {
          Style: @HeadStyle;
        }
      }

      Group #Grid {
        LayoutMode: Left;
        Anchor: (Left: 192, Top: 288, Width: 490, Height: 200);
      }

      Label #Empty {
        Anchor: (Left: 192, Top: 288, Width: 490, Height: 200);
        Text: "No saved skins";
        Style: (...@HeadStyle, HorizontalAlignment: Center);
        Visible: false;
      }

      Button #PrevPage {
        Anchor: (Left: 60, Top: 366, Width: 56, Height: 89);
        Style: (
          Default: (Background: (TexturePath: "PageLeft.png")),
          Hovered: (Background: (TexturePath: "PageLeftHover.png")),
          Pressed: (Background: (TexturePath: "PageLeftHover.png")),
          Sounds: $C.@ButtonSounds
        );
      }

      Button #NextPage {
        Anchor: (Left: 772, Top: 366, Width: 56, Height: 89);
        Style: (
          Default: (Background: (TexturePath: "PageRight.png")),
          Hovered: (Background: (TexturePath: "PageRightHover.png")),
          Pressed: (Background: (TexturePath: "PageRightHover.png")),
          Sounds: $C.@ButtonSounds
        );
      }
    }

    Label #Status {
      Anchor: (Left: 0, Top: 736, Width: 888, Height: 22);
      Style: (FontSize: 14, HorizontalAlignment: Center, VerticalAlignment: Center, TextColor: #96a9be);
    }
  }
}

$C.@BackButton {}
