// Made by dev/tools/render-wardrobe.py from Wardrobe.ui for the Feran wardrobe: edit Wardrobe.ui, then run the script.
$C = "../../Common.ui";

@HeadStyle = LabelStyle(
  FontSize: 12,
  VerticalAlignment: Center,
  RenderUppercase: true,
  TextColor: #c7ae7a,
  FontName: "Secondary",
  RenderBold: true,
  LetterSpacing: 0.5
);

@NameStyle = LabelStyle(
  FontSize: 12,
  Wrap: true,
  TextColor: #ecdcb8,
  FontName: "Secondary",
  RenderBold: true,
  HorizontalAlignment: Center,
  VerticalAlignment: Center
);

$C.@PageOverlay {
  LayoutMode: Middle;

  Group {
    Anchor: (Width: 1244, Height: 963);

    Label {
      Anchor: (Left: 0, Top: 0, Width: 1244, Height: 40);
      Text: "Wardrobe";
      Style: (...$C.@TitleStyle, FontSize: 22, HorizontalAlignment: Center, LetterSpacing: 1);
    }

    Group {
      Anchor: (Left: 0, Top: 40, Width: 1244, Height: 897);
      Background: (TexturePath: "Wardrobe_Feran.png");

      Label {
        Anchor: (Left: 394, Top: 260, Width: 300, Height: 18);
        Text: "Your skins";
        Style: @HeadStyle;
      }

      // the player's own skin, worn whenever no Locker skin is
      Group {
        Anchor: (Left: 386, Top: 258, Width: 94, Height: 200);

        Group #OwnWorn {
          Anchor: (Left: 0, Top: 56, Width: 94, Height: 150);
          Background: (TexturePath: "WornGlow.png");
          Visible: false;
        }

        Button #OwnCard {
          Anchor: (Left: 0, Top: 0, Width: 94, Height: 200);
          Style: (
            Default: (Background: #000000(0)),
            Hovered: (Background: (TexturePath: "HoverGlow.png")),
            Pressed: (Background: (TexturePath: "HoverGlow.png")),
            Sounds: $C.@ButtonSounds
          );

          Group #OwnHang {
            Anchor: (Left: 0, Top: 0, Width: 94, Height: 200);

            Group {
              Anchor: (Left: 16, Top: 23, Width: 63, Height: 86);
              Background: (TexturePath: "Hanger.png");
            }

            AssetImage #OwnPic {
              Anchor: (Left: 18, Top: 63, Width: 57, Height: 92);
              FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
            }

            Label #OwnName {
              Anchor: (Left: 0, Top: 162, Width: 94, Height: 34);
              Style: @NameStyle;
            }
          }
        }
      }

      Group #Grid {
        LayoutMode: Left;
        Anchor: (Left: 386, Top: 459, Width: 470, Height: 200);
      }

      Label #Empty {
        Anchor: (Left: 386, Top: 459, Width: 470, Height: 200);
        Text: "No saved skins";
        Style: (...@HeadStyle, HorizontalAlignment: Center);
        Visible: false;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Left: 394, Top: 453, Width: 458, Height: 28);

        Label {
          Text: "Designer skins";
          Style: @HeadStyle;
        }

        Label #Count {
          Padding: (Left: 10);
          Text: "0";
          Style: (...@HeadStyle, TextColor: #8f7c58);
        }

        Group { FlexWeight: 1; }

        Button #PagerPrev {
          Anchor: (Width: 24, Height: 28);
          Visible: false;
          Style: (
            Default: (Background: (TexturePath: "PagerLeft.png")),
            Hovered: (Background: (TexturePath: "PagerLeftHover.png")),
            Pressed: (Background: (TexturePath: "PagerLeftHover.png")),
            Sounds: $C.@ButtonSounds
          );
        }

        Label #Page {
          Anchor: (Width: 52);
          Style: (...@HeadStyle, HorizontalAlignment: Center);
        }

        Button #PagerNext {
          Anchor: (Width: 24, Height: 28);
          Visible: false;
          Style: (
            Default: (Background: (TexturePath: "PagerRight.png")),
            Hovered: (Background: (TexturePath: "PagerRightHover.png")),
            Pressed: (Background: (TexturePath: "PagerRightHover.png")),
            Sounds: $C.@ButtonSounds
          );
        }
      }

      // pages: a control made on each door's inside (an arrow carved or inlaid, or the door's own hardware), rendered in the doors'
      // angle; place and size as render-wardrobe.py prints them
      Button #PrevPage {
        Anchor: (Left: 102, Top: 224, Width: 120, Height: 114);
        Style: (
          Default: (Background: (TexturePath: "PageLeft_Feran.png")),
          Hovered: (Background: (TexturePath: "PageLeftHover_Feran.png")),
          Pressed: (Background: (TexturePath: "PageLeftHover_Feran.png")),
          Sounds: $C.@ButtonSounds
        );
      }

      Button #NextPage {
        Anchor: (Left: 1017, Top: 224, Width: 120, Height: 114);
        Style: (
          Default: (Background: (TexturePath: "PageRight_Feran.png")),
          Hovered: (Background: (TexturePath: "PageRightHover_Feran.png")),
          Pressed: (Background: (TexturePath: "PageRightHover_Feran.png")),
          Sounds: $C.@ButtonSounds
        );
      }

      // @doors {
      Button #DoorPrev {
        Anchor: (Left: 0, Top: 88, Width: 344, Height: 735);
        Visible: false;
        Style: (
          Default: (Background: #000000(0)),
          Hovered: (Background: (TexturePath: "DoorLeftHover_Feran.png")),
          Pressed: (Background: (TexturePath: "DoorLeftHover_Feran.png")),
          Sounds: $C.@ButtonSounds
        );
      }
      Button #DoorNext {
        Anchor: (Left: 894, Top: 108, Width: 350, Height: 735);
        Visible: false;
        Style: (
          Default: (Background: #000000(0)),
          Hovered: (Background: (TexturePath: "DoorRightHover_Feran.png")),
          Pressed: (Background: (TexturePath: "DoorRightHover_Feran.png")),
          Sounds: $C.@ButtonSounds
        );
      }
      // @doors }
    }

    Label #Status {
      Anchor: (Left: 0, Top: 939, Width: 1244, Height: 22);
      Style: (FontSize: 14, HorizontalAlignment: Center, VerticalAlignment: Center, TextColor: #96a9be);
    }
  }
}

$C.@BackButton {}
